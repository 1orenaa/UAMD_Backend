                    }
                },
                "responses": {
                    "200": {
                        "description": "Fjalëkalimi u përditësua"
                    },
                    "400": {
                        "description": "Kodi i verifikimi i pavlefshëm ose ka skaduar"
                    },
                    "422": {
                        "description": "Gabim validimi"
                    }
                }
            }
