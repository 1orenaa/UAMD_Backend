                "parameters": [
                    {
                        "name": "per_page",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "default": 20
                        }
                    },
                    {
                        "name": "search",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Listë me studentë e paginuar"
                    },
                    "401": {
                        "description": "Nuk je i autentikuar"
                    },
                    "403": {
                        "description": "Nuk ke rolin admin"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            },
            "post": {
                "tags": [
                    "Admin"
                ],
                "summary": "Shto student të ri",
                "operationId": "d6296b1c4c5d8c64ed6857df04bdb5a4",
