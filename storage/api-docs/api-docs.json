        "/auth/register": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Regjistro user të ri",
                "operationId": "08136088c4862c313b35d6518bab8d3a",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "email",
                                    "password",
                                    "password_confirmation",
                                    "role"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "Arta Kelmendi"
                                    },
                                    "email": {
                                        "type": "string",
                                        "example": "arta@uni.edu"
                                    },
                                    "password": {
                                        "type": "string",
                                        "example": "fjalkalim8"
                                    },
                                    "password_confirmation": {
                                        "type": "string",
                                        "example": "fjalkalim8"
                                    },
                                    "role": {
                                        "type": "string",
                                        "enum": [
                                            "student",
                                            "pedagog"
                                        ]
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Regjistrimi u krye me sukses"
                    },
                    "422": {
                        "description": "Gabim validimi"
                    },
                    "429": {
                        "description": "Rate limit i kaluar"
                    }
                }
            }
        },
