                                "properties": {
                                    "STD_EM": {
                                        "type": "string",
                                        "example": "Anisa"
                                    },
                                    "STD_MB": {
                                        "type": "string",
                                        "example": "Hoxha"
                                    },
                                    "STD_EMAIL": {
                                        "type": "string",
                                        "example": "anisa@uamd.edu.al"
                                    },
                                    "DEP_ID": {
                                        "type": "integer",
                                        "example": 1
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Studenti u krijua"
                    },
                    "422": {
                        "description": "Gabim validimi"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
